ALWAYS_EMBED_SWIFT_STANDARD_LIBRARIES = YES
CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER = NO
EXCLUDED_ARCHS[sdk=iphonesimulator*] = i386
FRAMEWORK_SEARCH_PATHS = $(inherited) "${PODS_CONFIGURATION_BUILD_DIR}/ChartboostCoreSDK" "${PODS_CONFIGURATION_BUILD_DIR}/ChartboostMediationAdapterChartboost" "${PODS_CONFIGURATION_BUILD_DIR}/ChartboostMediationSDK" "${PODS_ROOT}/BigoADS/BigoADS" "${PODS_ROOT}/ChartboostSDK" "${PODS_ROOT}/FBAudienceNetwork/Dynamic" "${PODS_ROOT}/Fyber_Marketplace_SDK/IASDKCore" "${PODS_ROOT}/InMobiSDK" "${PODS_ROOT}/SmartdigimktSDK/SmartDigimktSDK" "${PODS_ROOT}/TPNMediationAdxSmartdigimktAdapter/AnyThinkSmartdigimktAdapter-6.5.78.2.0" "${PODS_ROOT}/TPNMediationBigoAdapter/AnyThinkBigoAdapter-5.3.0.2.0" "${PODS_ROOT}/TPNMediationChartboostAdapter/AnyThinkChartboostAdapter-9.11.0.2.1" "${PODS_ROOT}/TPNMediationFacebookAdapter/AnyThinkFacebookAdapter-6.22.0.2.1" "${PODS_ROOT}/TPNMediationFyberAdapter/AnyThinkFyberAdapter-8.4.7.2.0" "${PODS_ROOT}/TPNMediationInmobiAdapter/AnyThinkInmobiAdapter-11.1.1.2.1" "${PODS_ROOT}/TPNMediationVungleAdapter/AnyThinkVungleAdapter-7.7.6.2.0" "${PODS_ROOT}/TPNiOS/core" "${PODS_ROOT}/VungleAds/static" "${PODS_XCFRAMEWORKS_BUILD_DIR}/BigoADS" "${PODS_XCFRAMEWORKS_BUILD_DIR}/ChartboostSDK" "${PODS_XCFRAMEWORKS_BUILD_DIR}/FBAudienceNetwork" "${PODS_XCFRAMEWORKS_BUILD_DIR}/Fyber_Marketplace_SDK" "${PODS_XCFRAMEWORKS_BUILD_DIR}/InMobiSDK" "${PODS_XCFRAMEWORKS_BUILD_DIR}/SmartdigimktSDK" "${PODS_XCFRAMEWORKS_BUILD_DIR}/TPNMediationAdxSmartdigimktAdapter" "${PODS_XCFRAMEWORKS_BUILD_DIR}/TPNMediationBigoAdapter" "${PODS_XCFRAMEWORKS_BUILD_DIR}/TPNMediationChartboostAdapter" "${PODS_XCFRAMEWORKS_BUILD_DIR}/TPNMediationFacebookAdapter" "${PODS_XCFRAMEWORKS_BUILD_DIR}/TPNMediationFyberAdapter" "${PODS_XCFRAMEWORKS_BUILD_DIR}/TPNMediationInmobiAdapter" "${PODS_XCFRAMEWORKS_BUILD_DIR}/TPNMediationVungleAdapter" "${PODS_XCFRAMEWORKS_BUILD_DIR}/TPNiOS/TPNSDK" "${PODS_XCFRAMEWORKS_BUILD_DIR}/VungleAds"
GCC_PREPROCESSOR_DEFINITIONS = $(inherited) COCOAPODS=1
HEADER_SEARCH_PATHS = $(inherited) "${PODS_CONFIGURATION_BUILD_DIR}/ChartboostCoreSDK/ChartboostCoreSDK.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/ChartboostMediationAdapterChartboost/ChartboostMediationAdapterChartboost.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/ChartboostMediationSDK/ChartboostMediationSDK.framework/Headers"
LD_RUNPATH_SEARCH_PATHS = $(inherited) /usr/lib/swift '@executable_path/Frameworks' '@loader_path/Frameworks'
LIBRARY_SEARCH_PATHS = $(inherited) "${TOOLCHAIN_DIR}/usr/lib/swift/${PLATFORM_NAME}" /usr/lib/swift
OTHER_LDFLAGS = $(inherited) -ObjC -l"c++" -l"resolv" -l"sqlite3" -l"sqlite3.0" -l"xml2" -l"xml2.2" -l"z" -framework "AVFoundation" -framework "AdSupport" -framework "AnyThinkBigoAdapter" -framework "AnyThinkChartboostAdapter" -framework "AnyThinkFacebookAdapter" -framework "AnyThinkFyberAdapter" -framework "AnyThinkInmobiAdapter" -framework "AnyThinkSDK" -framework "AnyThinkSmartdigimktAdapter" -framework "AnyThinkVungleAdapter" -framework "AppTrackingTransparency" -framework "AudioToolbox" -framework "BigoADS" -framework "CFNetwork" -framework "ChartboostCoreSDK" -framework "ChartboostMediationAdapterChartboost" -framework "ChartboostMediationSDK" -framework "ChartboostSDK" -framework "CoreFoundation" -framework "CoreGraphics" -framework "CoreImage" -framework "CoreMedia" -framework "CoreTelephony" -framework "FBAudienceNetwork" -framework "Foundation" -framework "IASDKCore" -framework "InMobiSDK" -framework "MediaPlayer" -framework "QuartzCore" -framework "SafariServices" -framework "Security" -framework "SmartdigimktSDK" -framework "StoreKit" -framework "SystemConfiguration" -framework "UIKit" -framework "VungleAdsSDK" -framework "WebKit" -weak_framework "AdSupport" -weak_framework "CFNetwork" -weak_framework "CoreMotion" -weak_framework "CoreTelephony" -weak_framework "Foundation" -weak_framework "LocalAuthentication" -weak_framework "SafariServices" -weak_framework "SystemConfiguration" -weak_framework "UIKit" -weak_framework "VideoToolbox" -weak_framework "WebKit"
OTHER_MODULE_VERIFIER_FLAGS = $(inherited) "-F${PODS_CONFIGURATION_BUILD_DIR}/BigoADS" "-F${PODS_CONFIGURATION_BUILD_DIR}/ChartboostCoreSDK" "-F${PODS_CONFIGURATION_BUILD_DIR}/ChartboostMediationAdapterChartboost" "-F${PODS_CONFIGURATION_BUILD_DIR}/ChartboostMediationSDK" "-F${PODS_CONFIGURATION_BUILD_DIR}/ChartboostSDK" "-F${PODS_CONFIGURATION_BUILD_DIR}/FBAudienceNetwork" "-F${PODS_CONFIGURATION_BUILD_DIR}/Fyber_Marketplace_SDK" "-F${PODS_CONFIGURATION_BUILD_DIR}/InMobiSDK" "-F${PODS_CONFIGURATION_BUILD_DIR}/SmartdigimktSDK" "-F${PODS_CONFIGURATION_BUILD_DIR}/TPNMediationAdxSmartdigimktAdapter" "-F${PODS_CONFIGURATION_BUILD_DIR}/TPNMediationBigoAdapter" "-F${PODS_CONFIGURATION_BUILD_DIR}/TPNMediationChartboostAdapter" "-F${PODS_CONFIGURATION_BUILD_DIR}/TPNMediationFacebookAdapter" "-F${PODS_CONFIGURATION_BUILD_DIR}/TPNMediationFyberAdapter" "-F${PODS_CONFIGURATION_BUILD_DIR}/TPNMediationInmobiAdapter" "-F${PODS_CONFIGURATION_BUILD_DIR}/TPNMediationVungleAdapter" "-F${PODS_CONFIGURATION_BUILD_DIR}/TPNiOS" "-F${PODS_CONFIGURATION_BUILD_DIR}/VungleAds"
OTHER_SWIFT_FLAGS = $(inherited) -D COCOAPODS
PODS_BUILD_DIR = ${BUILD_DIR}
PODS_CONFIGURATION_BUILD_DIR = ${PODS_BUILD_DIR}/$(CONFIGURATION)$(EFFECTIVE_PLATFORM_NAME)
PODS_PODFILE_DIR_PATH = ${SRCROOT}/.
PODS_ROOT = ${SRCROOT}/Pods
PODS_XCFRAMEWORKS_BUILD_DIR = $(PODS_CONFIGURATION_BUILD_DIR)/XCFrameworkIntermediates
USE_RECURSIVE_SCRIPT_INPUTS_IN_SCRIPT_PHASES = YES
