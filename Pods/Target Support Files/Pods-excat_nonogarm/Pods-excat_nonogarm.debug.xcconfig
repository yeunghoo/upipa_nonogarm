CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER = NO
EMBEDDED_CONTENT_CONTAINS_SWIFT = YES
EXCLUDED_ARCHS[sdk=iphonesimulator*] = i386
FRAMEWORK_SEARCH_PATHS = $(inherited) "${PODS_ROOT}/FBAudienceNetwork/Dynamic" "${PODS_ROOT}/SmartdigimktSDK/SmartDigimktSDK" "${PODS_ROOT}/TPNMediationAdxSmartdigimktAdapter/AnyThinkSmartdigimktAdapter-6.5.75.2.2" "${PODS_ROOT}/TPNMediationFacebookAdapter/AnyThinkFacebookAdapter-6.22.0.2.0" "${PODS_ROOT}/TPNiOS/core" "${PODS_XCFRAMEWORKS_BUILD_DIR}/FBAudienceNetwork" "${PODS_XCFRAMEWORKS_BUILD_DIR}/SmartdigimktSDK" "${PODS_XCFRAMEWORKS_BUILD_DIR}/TPNMediationAdxSmartdigimktAdapter" "${PODS_XCFRAMEWORKS_BUILD_DIR}/TPNMediationFacebookAdapter" "${PODS_XCFRAMEWORKS_BUILD_DIR}/TPNiOS/TPNSDK"
GCC_PREPROCESSOR_DEFINITIONS = $(inherited) COCOAPODS=1
LD_RUNPATH_SEARCH_PATHS = $(inherited) /usr/lib/swift '@executable_path/Frameworks' '@loader_path/Frameworks'
LIBRARY_SEARCH_PATHS = $(inherited) "${TOOLCHAIN_DIR}/usr/lib/swift/${PLATFORM_NAME}" /usr/lib/swift
OTHER_LDFLAGS = $(inherited) -ObjC -l"c++" -l"resolv" -l"sqlite3" -l"xml2" -l"z" -framework "AVFoundation" -framework "AnyThinkFacebookAdapter" -framework "AnyThinkSDK" -framework "AnyThinkSmartdigimktAdapter" -framework "AppTrackingTransparency" -framework "AudioToolbox" -framework "CoreGraphics" -framework "CoreImage" -framework "CoreMedia" -framework "FBAudienceNetwork" -framework "Foundation" -framework "Security" -framework "SmartdigimktSDK" -framework "StoreKit" -framework "SystemConfiguration" -framework "UIKit" -weak_framework "AdSupport" -weak_framework "CFNetwork" -weak_framework "CoreMotion" -weak_framework "CoreTelephony" -weak_framework "LocalAuthentication" -weak_framework "SafariServices" -weak_framework "SystemConfiguration" -weak_framework "VideoToolbox" -weak_framework "WebKit"
OTHER_MODULE_VERIFIER_FLAGS = $(inherited) "-F${PODS_CONFIGURATION_BUILD_DIR}/FBAudienceNetwork" "-F${PODS_CONFIGURATION_BUILD_DIR}/SmartdigimktSDK" "-F${PODS_CONFIGURATION_BUILD_DIR}/TPNMediationAdxSmartdigimktAdapter" "-F${PODS_CONFIGURATION_BUILD_DIR}/TPNMediationFacebookAdapter" "-F${PODS_CONFIGURATION_BUILD_DIR}/TPNiOS"
OTHER_SWIFT_FLAGS = $(inherited) -D COCOAPODS
PODS_BUILD_DIR = ${BUILD_DIR}
PODS_CONFIGURATION_BUILD_DIR = ${PODS_BUILD_DIR}/$(CONFIGURATION)$(EFFECTIVE_PLATFORM_NAME)
PODS_PODFILE_DIR_PATH = ${SRCROOT}/.
PODS_ROOT = ${SRCROOT}/Pods
PODS_XCFRAMEWORKS_BUILD_DIR = $(PODS_CONFIGURATION_BUILD_DIR)/XCFrameworkIntermediates
USE_RECURSIVE_SCRIPT_INPUTS_IN_SCRIPT_PHASES = YES
